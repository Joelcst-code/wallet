generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String        @id @default(uuid())
  privyUserId    String        @unique
  telefono       String        @unique
  nombre         String?
  cedula         String?
  direccionSolana String       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  enviadas       Transaction[] @relation("Enviadas")
  recibidas      Transaction[] @relation("Recibidas")
  enviosPendientesComoRemitente EnvioPendiente[] @relation("PendienteRemitente")
  enviosPendientesComoDestino  EnvioPendiente[] @relation("PendienteDestino")
}

enum TipoTransaccion {
  ENVIO
  RECARGA
}

model Transaction {
  id             String           @id @default(uuid())
  signature      String           @unique
  tipo           TipoTransaccion
  monto          Decimal          @db.Decimal(20, 6)
  deUserId       String?
  de             User?            @relation("Enviadas", fields: [deUserId], references: [id])
  paraUserId     String
  para           User             @relation("Recibidas", fields: [paraUserId], references: [id])
  createdAt      DateTime         @default(now())

  @@index([deUserId])
  @@index([paraUserId])
}

// Registro efímero creado en /preparar y consumido en /confirmar, para que
// el backend nunca confíe en el monto/destinatario que el cliente reenvía
// al confirmar — solo confía en lo que él mismo calculó al preparar la tx.
model EnvioPendiente {
  id           String   @id @default(uuid())
  remitenteId  String
  remitente    User     @relation("PendienteRemitente", fields: [remitenteId], references: [id])
  destinoId    String
  destino      User     @relation("PendienteDestino", fields: [destinoId], references: [id])
  monto        Decimal  @db.Decimal(20, 6)
  createdAt    DateTime @default(now())

  @@index([remitenteId])
}
